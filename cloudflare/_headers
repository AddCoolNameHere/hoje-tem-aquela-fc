# Cache do montador.
#
# O padrão do Pages é max-age=14400 (4h). Com isso, quem já tinha aberto o site
# continuava rodando o JS antigo por horas depois de uma atualização.
# Aqui o navegador passa a revalidar sempre: quando nada mudou vem um 304,
# que é barato; quando mudou, chega na hora.
#
# Só as rotas do /realtismo são afetadas — o resto do fusslabs.com segue igual.

/realtismo/assets/*
  Cache-Control: public, max-age=0, must-revalidate

/realtismo/data/*
  Cache-Control: no-store

/realtismo/cards/*
  Cache-Control: public, max-age=0, must-revalidate

/realtismo/
  Cache-Control: public, max-age=0, must-revalidate

/realtismo-adm/
  Cache-Control: public, max-age=0, must-revalidate
